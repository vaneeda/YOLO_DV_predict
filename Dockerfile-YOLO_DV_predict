# Use an official Python runtime as a parent image
FROM ultralytics/ultralytics:8.4.121
RUN echo

# User configuration - override with --build-arg
ARG user=myuser
ARG group=mygroup
ARG uid=1000
ARG gid=1000

# Set the working directory to
WORKDIR /project

# Some debs want to interact, even with apt-get install -y, this fixes it
ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/project

# Install any needed packages from apt
RUN apt-get update && apt-get install -y sudo python3 python3-pip git screen vim
RUN pip install --upgrade pip

# Configure user - the base image may already ship a user/group at this uid/gid
# (e.g. ultralytics/ultralytics:8.4.121's built-in "ubuntu" at 1000:1000), so rename
# it to $user instead of failing on a duplicate id
RUN groupadd -g $gid $user 2>/dev/null || groupmod -n $user "$(getent group $gid | cut -d: -f1)"
RUN useradd -u $uid -g $gid -m $user 2>/dev/null || usermod -l $user -d /home/$user -m "$(getent passwd $uid | cut -d: -f1)"
RUN usermod -a -G sudo $user
RUN passwd -d $user

RUN git clone https://github.com/vaneeda/YOLO_DV_predict.git

# ultralytics, pandas, pyyaml, tqdm, Pillow already ship with the ultralytics/ultralytics
# base image; lxml (used by csv2xml.py) is the only extra package.
RUN pip3 install --trusted-host pypi.python.org lxml

# this base image ships torch/torchvision built for CUDA 12.8, which needs a newer
# driver than some hosts have - reinstall from a CUDA index within that host's driver
# support. Override at build time to match the machine you're building for, e.g.:
#   --build-arg TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu124  (max CUDA 12.5, e.g. this dev laptop)
#   --build-arg TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu126  (max CUDA 12.6, e.g. the RTX 3090 host)
ARG TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu126
# --force-reinstall is required: the base image already has *a* torch installed, so a
# plain `pip install torch` sees that as satisfying the request and silently no-ops
# without ever consulting $TORCH_CUDA_INDEX, leaving the base image's CUDA build in place
RUN pip3 install --force-reinstall --index-url $TORCH_CUDA_INDEX torch torchvision

#COPY /redfish_model/train7/weights/best.pt /model/best.pt
#COPY /redfish_model/config_redfish.yaml /project/YOLO_DV_predict/model/config.yaml
# Run when the container launches
CMD ["/bin/bash", "-c", "cd /project/YOLO_DV_predict && python3 predict_DV.py"]

