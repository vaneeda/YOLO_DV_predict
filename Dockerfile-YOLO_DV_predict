# Variant image: app code + one variant's config/weights, built FROM a local base image
# tag (see Dockerfile.base) - never the network, so this build works fully offline.
# Rebuild this whenever predict_DV.py/csv2xml.py/utils.py or a variant's config/weights
# change; rebuild Dockerfile.base instead when system/python deps or the target host's
# CUDA index need to change.
#
# Pick the base tag matching the target host's CUDA index, e.g.:
#   docker build -t yolo_dv_redfish:latest --build-arg BASE_IMAGE=yolo_dv_base:cu126 --build-arg VARIANT=redfish -f Dockerfile-YOLO_DV_predict .
ARG BASE_IMAGE=yolo_dv_base:cu126
FROM ${BASE_IMAGE}

# App code baked in from the local working copy (not GitHub) - so the target machine
# needs no network access at all, not even to pull code
COPY predict_DV.py csv2xml.py utils.py /app/

# Config + weights for one variant, selected at build time, e.g. --build-arg VARIANT=redfish
# (see variants/<name>/)
ARG VARIANT
COPY variants/${VARIANT}/config.yaml /app/model/config.yaml
COPY variants/${VARIANT}/best.pt /app/model/best.pt

# Run when the container launches
CMD ["/bin/bash", "-c", "cd /app && python3 predict_DV.py"]
